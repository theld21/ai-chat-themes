{
  "manifest_version": 3,
  "name": "AI Chat Themes",
  "version": "0.5.0",
  "description": "Color themes and live ASCII wallpapers for Claude, ChatGPT, Gemini and Zalo, picked from the toolbar popup.",
  "author": "Aohkne",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "AI Chat Themes",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://chat.zalo.me/*"
      ],
      "js": [
        "theme.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
